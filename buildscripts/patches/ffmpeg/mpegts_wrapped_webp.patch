+/* Some HLS providers wrap MPEG-TS in a RIFF/WebP header. WebP probes at
+ * score 99, while TS with a short leading prefix normally probes lower.
+ * Prefer TS only after eight complete, valid packets within a bounded prefix;
+ * real WebP images and all other inputs retain the existing probing policy.
+ * The MPEG-TS reader already resynchronizes past these bytes at each segment.
+ */
+static int mpegts_wrapped_webp_probe(const AVProbeData *p)
+{
+    const int packet_count = 8;
+    int offset, count;
+    int limit;
+
+    if (p->buf_size < 12 + packet_count * TS_PACKET_SIZE ||
+        memcmp(p->buf, "RIFF", 4) || memcmp(p->buf + 8, "WEBP", 4))
+        return 0;
+
+    limit = FFMIN(512, p->buf_size - packet_count * TS_PACKET_SIZE);
+    for (offset = 12; offset <= limit; offset++) {
+        for (count = 0; count < packet_count; count++) {
+            const uint8_t *packet = p->buf + offset + count * TS_PACKET_SIZE;
+            if (packet[0] != 0x47 || (packet[1] & 0x80) ||
+                !(packet[3] & 0x30) ||
+                ((packet[3] & 0x20) && packet[4] > 183))
+                break;
+        }
+        if (count == packet_count)
+            return AVPROBE_SCORE_MAX;
+    }
+    return 0;
+}
+
 static int mpegts_probe(const AVProbeData *p)
 {
     const int size = p->buf_size;
@@ -3050,6 +3081,9 @@
     int check_count = size / TS_FEC_PACKET_SIZE;
 #define CHECK_COUNT 10
 #define CHECK_BLOCK 100
+
+    if (mpegts_wrapped_webp_probe(p))
+        return AVPROBE_SCORE_MAX;

     if (!check_count)
         return 0;
