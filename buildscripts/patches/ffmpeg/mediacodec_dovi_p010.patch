+/* Dolby Vision metadata transport for the Android MediaCodec HEVC wrapper.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef AVCODEC_MEDIACODEC_DOVI_H
+#define AVCODEC_MEDIACODEC_DOVI_H
+
+#include "dovi_rpu.h"
+#include "h2645_parse.h"
+
+#define FF_MEDIACODEC_DOVI_PENDING 128
+
+typedef struct FFMediaCodecDovi {
+    int enabled;
+    DOVIContext parser;
+    H2645Packet packet;
+    /* Snapshots are keyed by the timestamp MediaCodec returns, not decode order. */
+    AVFrame *pending[FF_MEDIACODEC_DOVI_PENDING];
+} FFMediaCodecDovi;
+
+void ff_mediacodec_dovi_init(FFMediaCodecDovi *s, AVCodecContext *avctx);
+void ff_mediacodec_dovi_flush(FFMediaCodecDovi *s);
+void ff_mediacodec_dovi_close(FFMediaCodecDovi *s);
+int ff_mediacodec_dovi_submit(FFMediaCodecDovi *s, AVCodecContext *avctx,
+                            const AVPacket *packet);
+int ff_mediacodec_dovi_attach(FFMediaCodecDovi *s, AVCodecContext *avctx,
+                            AVFrame *frame);
+#endif
--- /dev/null
+++ b/libavcodec/mediacodec_dovi.c
@@ -0,0 +1,154 @@
+/* Dolby Vision metadata transport for the Android MediaCodec HEVC wrapper.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#include "libavutil/mathematics.h"
+#include "decode.h"
+#include "hevc/hevc.h"
+#include "mediacodec_dovi.h"
+
+void ff_mediacodec_dovi_init(FFMediaCodecDovi *s, AVCodecContext *avctx)
+{
+    const AVPacketSideData *sd;
+    s->parser.logctx = avctx;
+    if (avctx->codec_id != AV_CODEC_ID_HEVC)
+        return;
+    sd = ff_get_coded_side_data(avctx, AV_PKT_DATA_DOVI_CONF);
+    if (sd && sd->size >= sizeof(s->parser.cfg)) {
+        s->parser.cfg = *(const AVDOVIDecoderConfigurationRecord *)sd->data;
+        s->enabled = s->parser.cfg.dv_profile == 5;
+    }
+}
+
+void ff_mediacodec_dovi_flush(FFMediaCodecDovi *s)
+{
+    for (int i = 0; i < FF_MEDIACODEC_DOVI_PENDING; i++)
+        av_frame_free(&s->pending[i]);
+    ff_dovi_ctx_flush(&s->parser);
+}
+
+void ff_mediacodec_dovi_close(FFMediaCodecDovi *s)
+{
+    ff_mediacodec_dovi_flush(s);
+    ff_h2645_packet_uninit(&s->packet);
+    ff_dovi_ctx_unref(&s->parser);
+}
+
+int ff_mediacodec_dovi_submit(FFMediaCodecDovi *s, AVCodecContext *avctx,
+                            const AVPacket *packet)
+{
+    AVFrame *metadata = NULL;
+    const H2645NAL *rpu = NULL;
+    int ret, has_picture = 0, slot = -1;
+    int64_t pts;
+    if (!s->enabled)
+        return 0;
+    ret = ff_h2645_packet_split(&s->packet, packet->data, packet->size,
+                               avctx, 0, AV_CODEC_ID_HEVC, H2645_FLAG_SMALL_PADDING);
+    if (ret < 0)
+        return ret;
+    for (int i = 0; i < s->packet.nb_nals; i++) {
+        const H2645NAL *nal = &s->packet.nals[i];
+        if (nal->nuh_layer_id)
+            continue;
+        has_picture |= nal->type <= 31;
+        if (nal->type == HEVC_NAL_UNSPEC62 && !nal->temporal_id && nal->size > 2) {
+            rpu = nal;
+            ret = ff_dovi_rpu_parse(&s->parser, nal->data + 2, nal->size - 2,
+                                    avctx->err_recognition);
+            if (ret < 0)
+                return ret;
+        }
+    }
+    if (!has_picture)
+        return 0;
+    if (packet->pts == AV_NOPTS_VALUE) {
+        av_log(avctx, AV_LOG_ERROR, "P5 hardware decode requires frame timestamps\n");
+        return AVERROR_INVALIDDATA;
+    }
+    pts = packet->pts;
+    /* Mirror the wrapper's microsecond conversion in both directions. */
+    if (avctx->pkt_timebase.num && avctx->pkt_timebase.den) {
+        pts = av_rescale_q(pts, avctx->pkt_timebase, AV_TIME_BASE_Q);
+        pts = av_rescale_q(pts, AV_TIME_BASE_Q, avctx->pkt_timebase);
+    }
+    for (int i = 0; i < FF_MEDIACODEC_DOVI_PENDING; i++) {
+        if (!s->pending[i] && slot < 0)
+            slot = i;
+        if (s->pending[i] && s->pending[i]->pts == pts) {
+            av_log(avctx, AV_LOG_ERROR, "Ambiguous P5 hardware frame timestamp\n");
+            return AVERROR_INVALIDDATA;
+        }
+    }
+    if (slot < 0) {
+        av_log(avctx, AV_LOG_ERROR, "P5 hardware metadata queue exhausted\n");
+        return AVERROR_INVALIDDATA;
+    }
+    metadata = av_frame_alloc();
+    if (!metadata)
+        return AVERROR(ENOMEM);
+    metadata->pts = pts;
+    ret = ff_dovi_attach_side_data(&s->parser, metadata);
+    if (ret < 0)
+        goto fail;
+    if (!av_frame_get_side_data(metadata, AV_FRAME_DATA_DOVI_METADATA)) {
+        av_log(avctx, AV_LOG_ERROR, "P5 hardware frame has no Dolby Vision metadata\n");
+        ret = AVERROR_INVALIDDATA;
+        goto fail;
+    }
+    if (rpu) {
+        AVFrameSideData *sd = av_frame_new_side_data(metadata,
+            AV_FRAME_DATA_DOVI_RPU_BUFFER, rpu->raw_size - 2);
+        if (!sd) {
+            ret = AVERROR(ENOMEM);
+            goto fail;
+        }
+        memcpy(sd->data, rpu->raw_data + 2, sd->size);
+    }
+    s->pending[slot] = metadata;
+    return 0;
+fail:
+    av_frame_free(&metadata);
+    return ret;
+}
+
+int ff_mediacodec_dovi_attach(FFMediaCodecDovi *s, AVCodecContext *avctx,
+                            AVFrame *frame)
+{
+    AVFrame *metadata = NULL;
+    int slot = -1, ret = 0;
+    if (!s->enabled)
+        return 0;
+    /* Do not let an opaque RGB conversion or 8-bit output reach gpu-next as P5. */
+    if (frame->format != AV_PIX_FMT_P010LE) {
+        av_log(avctx, AV_LOG_ERROR, "P5 hardware decode requires P010 output\n");
+        return AVERROR(ENOSYS);
+    }
+    for (int i = 0; i < FF_MEDIACODEC_DOVI_PENDING; i++) {
+        if (s->pending[i] && s->pending[i]->pts == frame->pts) {
+            slot = i;
+            break;
+        }
+    }
+    if (slot < 0) {
+        av_log(avctx, AV_LOG_ERROR, "No matching Dolby metadata for P5 hardware frame\n");
+        return AVERROR_INVALIDDATA;
+    }
+    metadata = s->pending[slot];
+    s->pending[slot] = NULL;
+    for (int i = 0; i < metadata->nb_side_data; i++) {
+        const AVFrameSideData *sd = metadata->side_data[i];
+        AVBufferRef *ref = av_buffer_ref(sd->buf);
+        if (!ref) {
+            ret = AVERROR(ENOMEM);
+            break;
+        }
+        av_frame_remove_side_data(frame, sd->type);
+        if (!av_frame_new_side_data_from_buf(frame, sd->type, ref)) {
+            av_buffer_unref(&ref);
+            ret = AVERROR(ENOMEM);
+            break;
+        }
+    }
+    av_frame_free(&metadata);
+    return ret;
+}
