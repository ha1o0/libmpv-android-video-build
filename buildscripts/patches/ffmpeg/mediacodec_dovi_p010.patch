@@ -0,0 +1,44 @@
+/* Bounds-checked Android COLOR_FormatYUVP010 copy.
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#ifndef AVCODEC_MEDIACODEC_P010_H
+#define AVCODEC_MEDIACODEC_P010_H
+#include <stdint.h>
+#include <string.h>
+#include "libavutil/error.h"
+
+/* MediaCodec stride is in bytes, slice-height in luma rows. P010 stores ten
+ * significant bits in the high bits of each little-endian 16-bit component. */
+static inline int ff_mediacodec_copy_p010(
+    uint8_t *dst_y, int dst_y_stride, uint8_t *dst_uv, int dst_uv_stride,
+    const uint8_t *src, size_t capacity, int offset, int length,
+    int stride, int slice_height, int crop_left, int crop_top,
+    int width, int height)
+{
+    uint64_t y, uv, end, y_bytes, uv_bytes, uv_rows;
+    if (!dst_y || !dst_uv || !src || offset < 0 || length < 0 ||
+        dst_y_stride <= 0 || dst_uv_stride <= 0 ||
+        stride <= 0 || slice_height <= 0 || width <= 0 || height <= 0 ||
+        crop_left < 0 || crop_top < 0 || (crop_left & 1) || (crop_top & 1))
+        return AVERROR_INVALIDDATA;
+    y_bytes = (uint64_t)width * 2;
+    uv_bytes = ((uint64_t)width + 1) / 2 * 4;
+    uv_rows = ((uint64_t)height + 1) / 2;
+    end = (uint64_t)offset + length;
+    if (end > capacity || y_bytes > dst_y_stride || uv_bytes > dst_uv_stride ||
+        (uint64_t)crop_left * 2 + uv_bytes > stride ||
+        (uint64_t)crop_top + height > slice_height)
+        return AVERROR_INVALIDDATA;
+    y = (uint64_t)offset + (uint64_t)crop_top * stride + (uint64_t)crop_left * 2;
+    uv = (uint64_t)offset + (uint64_t)slice_height * stride +
+         (uint64_t)(crop_top / 2) * stride + (uint64_t)crop_left * 2;
+    if (y + (uint64_t)(height - 1) * stride + y_bytes > end ||
+        uv + (uv_rows - 1) * stride + uv_bytes > end)
+        return AVERROR_INVALIDDATA;
+    for (int row = 0; row < height; row++)
+        memcpy(dst_y + (size_t)row * dst_y_stride, src + y + (size_t)row * stride, y_bytes);
+    for (unsigned row = 0; row < uv_rows; row++)
+        memcpy(dst_uv + (size_t)row * dst_uv_stride, src + uv + (size_t)row * stride, uv_bytes);
+    return 0;
+}
+#endif
