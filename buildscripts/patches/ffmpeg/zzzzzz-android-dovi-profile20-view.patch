+/* Android's HEVC decoders consume the base view of MV-HEVC. The app's
+ * 2D output selects that same view in software. Do not submit additional
+ * views to a Main10 decoder: some vendors fail after accepting a few frames.
+ * Dolby RPUs for the base view have already been copied before filtering. */
+static int filter_profile20_views(FFMediaCodecDovi *s, AVPacket *packet)
+{
+    if (!s->base_view_only)
+        return 0;
+    int size = 0, extra = 0;
+    for (int i = 0; i < s->packet.nb_nals; i++) {
+        H2645NAL *nal = &s->packet.nals[i];
+        if (nal->nuh_layer_id) extra++;
+        else {
+            if (nal->raw_size > INT_MAX - 4 - size)
+                return AVERROR_INVALIDDATA;
+            size += 4 + nal->raw_size;
+        }
+    }
+    if (!extra) return 0;
+    AVPacket filtered = {0};
+    int ret = av_new_packet(&filtered, size);
+    if (ret < 0) return ret;
+    ret = av_packet_copy_props(&filtered, packet);
+    if (ret < 0) {
+        av_packet_unref(&filtered);
+        return ret;
+    }
+    uint8_t *dst = filtered.data;
+    for (int i = 0; i < s->packet.nb_nals; i++) {
+        H2645NAL *nal = &s->packet.nals[i];
+        if (nal->nuh_layer_id) continue;
+        memcpy(dst, "\0\0\0\1", 4);
+        memcpy(dst + 4, nal->raw_data, nal->raw_size);
+        dst += 4 + nal->raw_size;
+    }
+    av_packet_unref(packet);
+    av_packet_move_ref(packet, &filtered);
+    return 0;
+}
