--- a/video/decode/vd_lavc.c
+++ b/video/decode/vd_lavc.c
@@ -560,6 +560,17 @@
                 if (!hw_codec || strcmp(hw_codec, codec) != 0)
                     continue;
 
+                // FFmpeg's Android MediaCodec HEVC wrapper does not export
+                // Dolby Vision RPU metadata. Profile 5 has no compatible HDR10
+                // base layer: decoding it as ordinary HEVC produces wrong colors.
+                // Software HEVC preserves the RPU for gpu-next/libplacebo.
+                if (ctx->codec->dovi && ctx->codec->dv_profile == 5 &&
+                    hwdec->codec->wrapper_name &&
+                    strcmp(hwdec->codec->wrapper_name, "mediacodec") == 0) {
+                    MP_VERBOSE(vd, "Skipping MediaCodec for Dolby Vision profile 5.\n");
+                    continue;
+                }
+
                 if (hwdec_auto_safe && !(hwdec->flags & HWDEC_FLAG_WHITELIST))
                     continue;
 
