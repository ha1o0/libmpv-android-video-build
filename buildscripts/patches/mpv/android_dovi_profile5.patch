--- a/video/decode/vd_lavc.c
+++ b/video/decode/vd_lavc.c
@@ -560,6 +560,17 @@
                 if (!hw_codec || strcmp(hw_codec, codec) != 0)
                     continue;
 
+                // P5 needs raw 10-bit components for Dolby reshaping. Android's
+                // external OES texture path already converts them to RGB. Use
+                // MediaCodec copy-back (P010 + per-frame RPU), then gpu-next.
+                if (ctx->codec->dovi && ctx->codec->dv_profile == 5 &&
+                    hwdec->codec->wrapper_name &&
+                    strcmp(hwdec->codec->wrapper_name, "mediacodec") == 0 &&
+                    !hwdec->copying) {
+                    MP_VERBOSE(vd, "P5: selecting MediaCodec P010 copy-back.\n");
+                    continue;
+                }
+
                 if (hwdec_auto_safe && !(hwdec->flags & HWDEC_FLAG_WHITELIST))
                     continue;
 
