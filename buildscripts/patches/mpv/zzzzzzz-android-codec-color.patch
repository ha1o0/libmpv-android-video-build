+// Matroska's Colour is stored outside lav_codecpar. A decoder Surface needs
+// this information at configuration time, before mpv can merge frame metadata.
+static int mediacodec_container_color(AVCodecContext *avctx,
+                                     const struct mp_codec_params *c)
+{
+    if (c->color.primaries && avctx->color_primaries == AVCOL_PRI_UNSPECIFIED)
+        avctx->color_primaries = pl_primaries_to_av(c->color.primaries);
+    if (c->color.transfer && avctx->color_trc == AVCOL_TRC_UNSPECIFIED)
+        avctx->color_trc = pl_transfer_to_av(c->color.transfer);
+    if (c->repr.sys && avctx->colorspace == AVCOL_SPC_UNSPECIFIED)
+        avctx->colorspace = pl_system_to_av(c->repr.sys);
+    if (c->repr.levels && avctx->color_range == AVCOL_RANGE_UNSPECIFIED)
+        avctx->color_range = pl_levels_to_av(c->repr.levels);
+
+    AVFrame *frame = av_frame_alloc();
+    if (!frame) return AVERROR(ENOMEM);
+    pl_avframe_set_color(frame, c->color);
+    int ret = 0;
+    for (int i = 0; i < frame->nb_side_data; i++) {
+        AVFrameSideData *sd = frame->side_data[i];
+        enum AVPacketSideDataType type;
+        if (sd->type == AV_FRAME_DATA_MASTERING_DISPLAY_METADATA)
+            type = AV_PKT_DATA_MASTERING_DISPLAY_METADATA;
+        else if (sd->type == AV_FRAME_DATA_CONTENT_LIGHT_LEVEL)
+            type = AV_PKT_DATA_CONTENT_LIGHT_LEVEL;
+        else
+            continue;
+        if (av_packet_side_data_get(avctx->coded_side_data,
+                                    avctx->nb_coded_side_data, type))
+            continue;
+        AVPacketSideData *dst = av_packet_side_data_new(&avctx->coded_side_data,
+            &avctx->nb_coded_side_data, type, sd->size, 0);
+        if (!dst) { ret = AVERROR(ENOMEM); break; }
+        memcpy(dst->data, sd->data, sd->size);
+    }
+    av_frame_free(&frame);
+    return ret;
+}
+#endif
