 #include "egl_helpers.h"
 #include "common/common.h"
 #include "context.h"
+#include "utils.h"
 
 struct priv {
     struct GL gl;
     EGLDisplay egl_display;
     EGLContext egl_context;
     EGLSurface egl_surface;
+    EGLConfig egl_config;
+    EGLint colorspace;
+    EGLint logged_colorspace;
+    int depth;
+    bool hdr_failed;
 };
+
+// The application advertises capabilities only for a direct SurfaceView. A
+// SurfaceProducer/Flutter texture must leave this mask at zero.
+static int android_refine_config(void *opaque, EGLConfig *configs, int count)
+{
+    struct ra_ctx *ctx = opaque;
+    struct priv *p = ctx->priv;
+    if (!ctx->vo->opts->android_hdr_capabilities)
+        return 0;
+    for (int n = 0; n < count; n++) {
+        EGLint r, g, b, a;
+        eglGetConfigAttrib(p->egl_display, configs[n], EGL_RED_SIZE, &r);
+        eglGetConfigAttrib(p->egl_display, configs[n], EGL_GREEN_SIZE, &g);
+        eglGetConfigAttrib(p->egl_display, configs[n], EGL_BLUE_SIZE, &b);
+        eglGetConfigAttrib(p->egl_display, configs[n], EGL_ALPHA_SIZE, &a);
+        if (r == 10 && g == 10 && b == 10 && a == 2)
+            return n;
+    }
+    // The renderer remains usable with an SDR-only EGL implementation.
+    return 0;
+}
+
+static bool android_create_surface(struct ra_ctx *ctx, EGLint colorspace)
+{
+    struct priv *p = ctx->priv;
+    ANativeWindow *window = vo_android_native_window(ctx->vo);
+    EGLint attributes[] = {EGL_GL_COLORSPACE_KHR, colorspace, EGL_NONE};
+    EGLSurface surface = eglCreateWindowSurface(p->egl_display, p->egl_config,
+        (EGLNativeWindowType)window, colorspace ? attributes : NULL);
+    if (surface == EGL_NO_SURFACE)
+        return false;
+    if (!eglMakeCurrent(p->egl_display, surface, surface, p->egl_context)) {
+        eglDestroySurface(p->egl_display, surface);
+        return false;
+    }
+    p->egl_surface = surface;
+    p->colorspace = colorspace;
+    return true;
+}
+
+static bool android_change_surface(struct ra_ctx *ctx, EGLint colorspace)
+{
+    struct priv *p = ctx->priv;
+    if (p->egl_surface && colorspace == p->colorspace)
+        return true;
+    // Retain the GLES context (textures, shader programs and libass atlases).
+    // EGL forbids two EGLSurfaces for the same native window, so detach first.
+    eglMakeCurrent(p->egl_display, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    if (p->egl_surface)
+        eglDestroySurface(p->egl_display, p->egl_surface);
+    p->egl_surface = EGL_NO_SURFACE;
+    if (android_create_surface(ctx, colorspace))
+        return true;
+    MP_WARN(ctx, "HDR EGL colorspace rejected; restoring SDR output.\n");
+    p->hdr_failed = true;
+    bool restored = android_create_surface(ctx, 0);
+    if (!restored)
+        MP_ERR(ctx, "Failed restoring SDR EGL surface\n");
+    return restored && colorspace == 0;
+}
+
+static void android_hdr_metadata(struct ra_ctx *ctx,
+                                 const struct pl_color_space *color)
+{
+    struct priv *p = ctx->priv;
+    if (color->transfer != PL_COLOR_TRC_PQ || !p->egl_surface)
+        return;
+    const struct pl_hdr_metadata *hdr = &color->hdr;
+    const char *ext = eglQueryString(p->egl_display, EGL_EXTENSIONS);
+    if (gl_check_extension(ext, "EGL_EXT_surface_SMPTE2086_metadata")) {
+        const struct pl_raw_primaries *prim = &hdr->prim;
+        if (!pl_primaries_valid(prim))
+            prim = pl_raw_primaries_get(color->primaries);
+        const EGLint keys[] = {
+            EGL_SMPTE2086_DISPLAY_PRIMARY_RX_EXT, EGL_SMPTE2086_DISPLAY_PRIMARY_RY_EXT,
+            EGL_SMPTE2086_DISPLAY_PRIMARY_GX_EXT, EGL_SMPTE2086_DISPLAY_PRIMARY_GY_EXT,
+            EGL_SMPTE2086_DISPLAY_PRIMARY_BX_EXT, EGL_SMPTE2086_DISPLAY_PRIMARY_BY_EXT,
+            EGL_SMPTE2086_WHITE_POINT_X_EXT, EGL_SMPTE2086_WHITE_POINT_Y_EXT,
+            EGL_SMPTE2086_MAX_LUMINANCE_EXT, EGL_SMPTE2086_MIN_LUMINANCE_EXT,
+        };
+        const float values[] = {prim->red.x, prim->red.y, prim->green.x, prim->green.y,
+            prim->blue.x, prim->blue.y, prim->white.x, prim->white.y,
+            hdr->max_luma, hdr->min_luma};
+        for (int n = 0; n < MP_ARRAY_SIZE(keys); n++) {
+            if (isfinite(values[n]) && values[n] >= 0 && values[n] <= 10000)
+                eglSurfaceAttrib(p->egl_display, p->egl_surface, keys[n],
+                                 (EGLint)lrintf(values[n] * EGL_METADATA_SCALING_EXT));
+        }
+    }
+    if (gl_check_extension(ext, "EGL_EXT_surface_CTA861_3_metadata")) {
+        if (isfinite(hdr->max_cll) && hdr->max_cll >= 0 && hdr->max_cll <= 10000)
+            eglSurfaceAttrib(p->egl_display, p->egl_surface,
+                EGL_CTA861_3_MAX_CONTENT_LIGHT_LEVEL_EXT,
+                (EGLint)lrintf(hdr->max_cll * EGL_METADATA_SCALING_EXT));
+        if (isfinite(hdr->max_fall) && hdr->max_fall >= 0 && hdr->max_fall <= 10000)
+            eglSurfaceAttrib(p->egl_display, p->egl_surface,
+                EGL_CTA861_3_MAX_FRAME_AVERAGE_LEVEL_EXT,
+                (EGLint)lrintf(hdr->max_fall * EGL_METADATA_SCALING_EXT));
+    }
+}
+
+static bool android_set_color(struct ra_ctx *ctx, struct mp_image_params *params)
+{
+    struct priv *p = ctx->priv;
+    // Keep legacy textures on their original path, including target options.
+    if (!ctx->vo->opts->android_hdr_capabilities)
+        return false;
+    const char *ext = eglQueryString(p->egl_display, EGL_EXTENSIONS);
+    EGLint colorspace = 0;
+    if (params && p->depth >= 10 && !p->hdr_failed &&
+        params->color.primaries == PL_COLOR_PRIM_BT_2020) {
+        if (params->color.transfer == PL_COLOR_TRC_PQ &&
+            (ctx->vo->opts->android_hdr_capabilities & 1) &&
+            gl_check_extension(ext, "EGL_EXT_gl_colorspace_bt2020_pq"))
+            colorspace = EGL_GL_COLORSPACE_BT2020_PQ_EXT;
+        if (params->color.transfer == PL_COLOR_TRC_HLG &&
+            (ctx->vo->opts->android_hdr_capabilities & 2) &&
+            gl_check_extension(ext, "EGL_EXT_gl_colorspace_bt2020_hlg"))
+            colorspace = EGL_GL_COLORSPACE_BT2020_HLG_EXT;
+    }
+    if (!android_change_surface(ctx, colorspace))
+        colorspace = 0;
+    if (params) {
+        // Report the accepted output, never just the requested HDR transfer.
+        if (!colorspace)
+            params->color = pl_color_space_srgb;
+        params->repr.bits = (struct pl_bit_encoding){
+            .sample_depth = p->depth, .color_depth = p->depth,
+        };
+        android_hdr_metadata(ctx, &params->color);
+    }
+    if (p->logged_colorspace != colorspace) {
+        MP_INFO(ctx, "Android output: %s, %d-bit, libmpv GPU subtitles enabled\n",
+            colorspace == EGL_GL_COLORSPACE_BT2020_PQ_EXT ? "BT.2020/PQ" :
+            colorspace == EGL_GL_COLORSPACE_BT2020_HLG_EXT ? "BT.2020/HLG" : "SDR",
+            p->depth);
+        p->logged_colorspace = colorspace;
+    }
+    return true;
+}
+
+static pl_color_space_t android_preferred_csp(struct ra_ctx *ctx)
+{
+    // Auto negotiation must start at SDR and inspect each source. Reporting
+    // HDR here would incorrectly expand ordinary SDR video to HDR.
+    return ctx->vo->opts->android_hdr_capabilities
+        ? pl_color_space_srgb : (pl_color_space_t){0};
+}
+
+static int android_color_depth(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    return p->depth;
+}
 
