 {
     switch (type) {
@@ -103,6 +107,46 @@
     avcodec_parameters_free(&avp);
     return NULL;
 }
+
+#if HAVE_ANDROID
+// Surface/decoder selection runs before the first decoded frame. Some MKVs
+// omit Colour entirely but carry BT.2020/PQ in HEVC CodecPrivate (SPS/VUI).
+// Probe headers once on the demux thread, without decoding frames or changing
+// the metadata passed to the real decoder. Missing/invalid headers stay unknown.
+struct pl_color_space mp_get_codec_color_hint(const struct mp_codec_params *c)
+{
+    struct pl_color_space color = c->color;
+    if (c->type != STREAM_VIDEO || (color.transfer && color.primaries))
+        return color;
+
+    AVCodecParameters *avp = mp_codec_params_to_av(c);
+    if (!avp)
+        return color;
+    if (!color.transfer)
+        color.transfer = pl_transfer_from_av(avp->color_trc);
+    if (!color.primaries)
+        color.primaries = pl_primaries_from_av(avp->color_primaries);
+
+    if ((!color.transfer || !color.primaries) &&
+        avp->codec_id == AV_CODEC_ID_HEVC && avp->extradata &&
+        avp->extradata_size > 0 && avp->extradata_size <= 0x1000000) {
+        const AVCodec *codec = avcodec_find_decoder(AV_CODEC_ID_HEVC);
+        AVCodecContext *avctx = codec ? avcodec_alloc_context3(codec) : NULL;
+        if (avctx && avcodec_parameters_to_context(avctx, avp) >= 0) {
+            avctx->thread_count = 1;
+            if (avcodec_open2(avctx, codec, NULL) >= 0) {
+                if (!color.transfer)
+                    color.transfer = pl_transfer_from_av(avctx->color_trc);
+                if (!color.primaries)
+                    color.primaries = pl_primaries_from_av(avctx->color_primaries);
+            }
+        }
+        avcodec_free_context(&avctx);
+    }
+    avcodec_parameters_free(&avp);
+    return color;
+}
+#endif
 
