+// The video remains in MediaCodec's surface queue. Only changed subtitle
+// pixels cross the CPU/compositor boundary, using mpv's own OSD/libass state.
+static void draw_subtitles(struct vo *vo, double pts)
+{
+    struct priv *p = vo->priv;
+    if (!p->subtitle_window || !p->subtitle_cache) return;
+    int width = vo->opts->android_surface_size.w;
+    int height = vo->opts->android_surface_size.h;
+    if (width <= 0 || height <= 0) return;
+    // A separate overlay never needs the source's 8K allocation. Keep its
+    // aspect ratio so the native view can use the same video fit geometry.
+    double scale = MPMIN(1.0, 1920.0 / MPMAX(width, height));
+    width = MPMAX(2, (int)(width * scale + .5));
+    height = MPMAX(2, (int)(height * scale + .5));
+    bool resized = width != p->subtitle_width || height != p->subtitle_height;
+    if (resized) {
+        if (ANativeWindow_setBuffersGeometry(p->subtitle_window, width, height,
+                                            WINDOW_FORMAT_RGBA_8888) < 0) return;
+        p->subtitle_width = width; p->subtitle_height = height;
+        p->have_subtitle_frame = false;
+    }
+    struct mp_osd_res res = {.w = width, .h = height, .display_par = 1};
+    struct sub_bitmap_list *list = osd_render(vo->osd, res, pts, 0,
+                                             mp_draw_sub_formats);
+    if (!list) return;
+    if (p->have_subtitle_frame && list->change_id == p->subtitle_change_id) {
+        talloc_free(list);
+        return;
+    }
+    int active = 0, modified = 0;
+    struct mp_rect active_rects[64], modified_rects[64];
+    struct mp_image *overlay = mp_draw_sub_overlay(p->subtitle_cache, list,
+        active_rects, MP_ARRAY_SIZE(active_rects), &active,
+        modified_rects, MP_ARRAY_SIZE(modified_rects), &modified);
+    if (overlay) {
+        ANativeWindow_Buffer buffer;
+        if (ANativeWindow_lock(p->subtitle_window, &buffer, NULL) == 0) {
+            // Premultiplied BGRA from libass/bitmap subtitle composition -> RGBA.
+            for (int y = 0; y < buffer.height; y++) {
+                uint8_t *out = (uint8_t *)buffer.bits + (size_t)y * buffer.stride * 4;
+                if (y >= height) {
+                    memset(out, 0, (size_t)buffer.width * 4);
+                    continue;
+                }
+                const uint8_t *in = overlay->planes[0] + y * overlay->stride[0];
+                int n = MPMIN(width, buffer.width);
+                for (int x = 0; x < n; x++) {
+                    out[4*x] = in[4*x+2]; out[4*x+1] = in[4*x+1];
+                    out[4*x+2] = in[4*x]; out[4*x+3] = in[4*x+3];
+                }
+                if (n < buffer.width) memset(out + n*4, 0, (buffer.width-n)*4);
+            }
+            ANativeWindow_unlockAndPost(p->subtitle_window);
+            MP_DBG(vo, "Subtitle overlay: active=%d pts=%.3f\n", active, pts);
+            p->subtitle_change_id = list->change_id;
+            p->have_subtitle_frame = true;
+        }
+    }
+    talloc_free(list);
+}
